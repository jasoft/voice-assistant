FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    python3 \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @deepseek-ai/dsh@0.1.2-rc.1 \
    && sed -i 's/options.host === "0.0.0.0"/false/g' $(find /usr/local/lib/node_modules -name startup.js) \
    && node -e '\
const fs = require("fs"); \
const p = require("child_process").execSync("find /usr/local/lib/node_modules -path \"*/@deepseek-ai/dsh-client-connection/lib/index.js\"").toString().trim(); \
let c = fs.readFileSync(p, "utf8"); \
c = c.replace("const endpoint = pathname.slice(channel.length + 1);", "let endpoint = pathname.slice(channel.length + 1); if (endpoint.includes(\".\")) endpoint = endpoint.replace(\".\", \"/\");"); \
c = c.replace("const message = envelope.data;", "const message = envelope.data; if (typeof message.method === \"string\" && message.method.includes(\".\")) message.method = message.method.replace(\".\", \"/\");"); \
c = c.replace("this.browserAuth.isAuthenticated(request) ? void 0 : 401", "void 0"); \
fs.writeFileSync(p, c, "utf8"); \
console.log("dsh-client-connection patched");'




COPY scripts/start_dsh.sh ./scripts/start_dsh.sh
COPY scripts/memo_api.py /app/scripts/memo_api.py
COPY scripts/reminder_http_create.py /app/scripts/reminder_http_create.py
RUN chmod +x /app/scripts/start_dsh.sh /app/scripts/memo_api.py /app/scripts/reminder_http_create.py

EXPOSE 3080

ENTRYPOINT ["/app/scripts/start_dsh.sh"]

