FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    make \
    g++ \
    python3 \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

COPY deepseek-harness/ ./deepseek-harness/
COPY scripts/start_dsh.sh ./scripts/start_dsh.sh
COPY scripts/memo_api.py /app/scripts/memo_api.py
COPY scripts/reminder_http_create.py /app/scripts/reminder_http_create.py
RUN chmod +x /app/scripts/memo_api.py /app/scripts/reminder_http_create.py

RUN pnpm --dir /app/deepseek-harness install --frozen-lockfile
RUN pnpm --dir /app/deepseek-harness run build

EXPOSE 3080

ENTRYPOINT ["/app/scripts/start_dsh.sh"]
